          <mxGeometry x="250" y="130" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="predhead2" value="策略—价值头 π̂、v̂（θ_pred）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#C2185B;" vertex="1" parent="modB2">
          <mxGeometry x="250" y="200" width="240" height="60" as="geometry"/>
