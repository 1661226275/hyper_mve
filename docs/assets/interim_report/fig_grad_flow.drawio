<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="gradflow" name="训练梯度流向">
    <mxGraphModel dx="1500" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="replaybatch" value="回放批次&lt;br&gt;观测序列、动作、收益 r、&lt;br&gt;π^mve、构型真值 g_true&lt;br&gt;（真值仅训练期可用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#616161;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="350" width="190" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="modA2" value="角色感知模块（2.2.1）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fillColor=#fff8f0;strokeColor=#FF9800;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="520" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="beliefnet2" value="BeliefNet（GRU）&lt;br&gt;→ 构型后验 ĝ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FB8C00;" vertex="1" parent="modA2">
          <mxGeometry x="20" y="50" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mix" value="课程混合&lt;br&gt;g_main = w·onehot(g_true) + (1−w)·ĝ&lt;br&gt;（w：1→0 线性退火）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#F9A825;" vertex="1" parent="modA2">
          <mxGeometry x="250" y="50" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="roleenc2" value="RoleEncoder（角色表征）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FB8C00;" vertex="1" parent="modA2">
          <mxGeometry x="20" y="200" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="beliefenc2" value="BeliefEncoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FB8C00;" vertex="1" parent="modA2">
          <mxGeometry x="250" y="160" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ctx2" value="ctx（角色 ⊕ 信念）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#FB8C00;" vertex="1" parent="modA2">
