        <mxCell id="modB2" value="世界模型模块（2.2.1）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fillColor=#f0f6ff;strokeColor=#1976D2;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="390" width="520" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="repnet2" value="表征网络 o → s（共享）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;" vertex="1" parent="modB2">
          <mxGeometry x="20" y="40" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="transnet2" value="转移网络（共享）&lt;br&gt;K 步潜在展开&lt;br&gt;⊘④ 展开半梯度（0.5 截断）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;" vertex="1" parent="modB2">
          <mxGeometry x="20" y="130" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="emanet" value="EMA 目标网络&lt;br&gt;提供价值自举目标&lt;br&gt;⊘② 不回传梯度" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#eeeeee;strokeColor=#757575;" vertex="1" parent="modB2">
          <mxGeometry x="20" y="240" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hyper2" value="DualHyperNetwork → θ_rew、θ_pred" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#C2185B;" vertex="1" parent="modB2">
          <mxGeometry x="250" y="40" width="240" height="60" as="geometry"/>
        </mxCell>
