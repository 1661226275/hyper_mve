        </mxCell>
        <mxCell id="modC2" value="MVE 规划器模块（2.2.2）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fillColor=#faf4fb;strokeColor=#9C27B0;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="550" width="200" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="pimve" value="π^mve 蒸馏目标&lt;br&gt;（采集期由规划器产生，&lt;br&gt;经回放池提供）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8E24AA;" vertex="1" parent="modC2">
          <mxGeometry x="15" y="45" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lbelief" value="信念损失 L_belief&lt;br&gt;CE(ĝ, g_true) + 多样性正则&lt;br&gt;（梯度仅训练 BeliefNet）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="870" y="60" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lpolicy" value="策略蒸馏损失 L_policy = CE(π̂, π^mve)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="870" y="175" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lvalue" value="价值损失 L_value&lt;br&gt;目标：n 步回报 + EMA 自举（⊘②）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="870" y="265" width="270" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="lreward" value="奖励损失 L_reward = MSE(r̂, r)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="870" y="365" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lconsist" value="一致性损失 L_consist&lt;br&gt;ŝ′ 对齐 sg[编码(o′)]（⊘③ 目标侧截断）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="870" y="455" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="total" value="总损失&lt;br&gt;1.0·L_policy + 0.25·L_value&lt;br&gt;+ 3.0·L_reward + 0.5·L_consist&lt;br&gt;+ 1.0·L_belief&lt;br&gt;单一 Adam 优化器联合更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#F9A825;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="230" width="220" height="150" as="geometry"/>
        </mxCell>
