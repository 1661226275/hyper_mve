        <mxCell id="legend" value="图例：实线 = 前向数据流；灰虚线 = 不回传梯度的目标；红虚线 = 梯度反传；⊘①–④ = 停梯度边界" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
