          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ga3" value="⊘① 信念梯度门控（前 5000 步主任务梯度不回传）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#c62828;" edge="1" parent="1" source="beliefenc2" target="ctx2">
          <mxGeometry relative="1" as="geometry"/>
