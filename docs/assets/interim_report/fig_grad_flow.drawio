        <mxCell id="g15" value="梯度沿前向路径反传（受 ⊘ 边界截断）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#c62828;fontColor=#c62828;fontSize=11;" edge="1" parent="1" source="total" target="modB2">
