id=3D"A2.SS2.p2.1.m1.1.1.1.cmml" xref=3D"A2.SS2.p2.1.m1.1.1">superscript</c=
symbol><cn id=3D"A2.SS2.p2.1.m1.1.1.2.cmml" type=3D"integer" xref=3D"A2.SS2=
.p2.1.m1.1.1.2">10</cn><apply id=3D"A2.SS2.p2.1.m1.1.1.3.cmml" xref=3D"A2.S=
S2.p2.1.m1.1.1.3"><minus id=3D"A2.SS2.p2.1.m1.1.1.3.1.cmml" xref=3D"A2.SS2.=
p2.1.m1.1.1.3"></minus><cn id=3D"A2.SS2.p2.1.m1.1.1.3.2.cmml" type=3D"integ=
er" xref=3D"A2.SS2.p2.1.m1.1.1.3.2">4</cn></apply></apply></annotation-xml>=
<annotation encoding=3D"application/x-tex" id=3D"A2.SS2.p2.1.m1.1c">10^{-4}=
</annotation><annotation encoding=3D"application/x-llamapun" id=3D"A2.SS2.p=
2.1.m1.1d">10 start_POSTSUPERSCRIPT - 4 end_POSTSUPERSCRIPT</annotation></s=
emantics></math>. Samples are drawn from the replay buffer according to pri=
oritized replay&nbsp;<cite class=3D"ltx_cite ltx_citemacro_citep">(Schaul e=
t&nbsp;al., <a class=3D"ltx_ref" href=3D"https://arxiv.org/html/2405.11778v=
1#bib.bib41" title=3D"">2015</a>)</cite> using the same priority and hyperp=
arameters as in MuZero.</p><button class=3D"sr-only button" style=3D"displa=
y: none;">Report issue for preceding element</button>
</div>
<div class=3D"ltx_para ltx_noindent" id=3D"A2.SS2.p3">
<p class=3D"ltx_p" id=3D"A2.SS2.p3.2">In practice, we re-execute OS(<math a=
lttext=3D"\lambda" class=3D"ltx_Math" display=3D"inline" id=3D"A2.SS2.p3.1.=
m1.1"><semantics id=3D"A2.SS2.p3.1.m1.1a"><mi id=3D"A2.SS2.p3.1.m1.1.1" xre=
f=3D"A2.SS2.p3.1.m1.1.1.cmml">=CE=BB</mi><annotation-xml encoding=3D"MathML=
-Content" id=3D"A2.SS2.p3.1.m1.1b"><ci id=3D"A2.SS2.p3.1.m1.1.1.cmml" xref=
=3D"A2.SS2.p3.1.m1.1.1">=F0=9D=9C=86</ci></annotation-xml><annotation encod=
ing=3D"application/x-tex" id=3D"A2.SS2.p3.1.m1.1c">\lambda</annotation><ann=
