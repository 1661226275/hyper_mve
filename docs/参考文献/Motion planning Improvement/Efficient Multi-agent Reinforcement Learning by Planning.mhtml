2.p3.1.m1.2.2.2.4.1">,</mo><mn id=3D"S3.SS2.p3.1.m1.2.2.2.2">0</mn></mrow><=
/msub><mo id=3D"S3.SS2.p3.1.m1.2.4.5" stretchy=3D"false">)</mo></mrow></mro=
w><annotation encoding=3D"application/x-tex" id=3D"S3.SS2.p3.1.m1.2c">\omeg=
a(\cdot|s_{t,0})</annotation><annotation encoding=3D"application/x-llamapun=
